NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/threat-modeler
# Make this long and random. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Production refuses to start if it is missing, short, or still this placeholder.
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
# The address of your frontend. Several are allowed, separated by commas. No trailing slash.
CLIENT_ORIGIN=http://localhost:5173

# Optional. The public address of this API, used to build the GitHub webhook address shown on the Watched repos page.
# Example: https://threat-modeler-bz87.onrender.com   (if empty, the address the request came in on is used)
PUBLIC_API_URL=
# Upload gate per file (default 100). Larger archives are accepted: oversized
# entries are skipped with a warning and the rest still gets scanned.
MAX_UPLOAD_MB=100

# agent = real scanner (rules + dependency check + optional AI review), mock = sample data
SCANNER_PROVIDER=agent

# Optional AI review layer. Set the key for ONE provider (leave all empty to skip this layer).
# AI_PROVIDER is auto-detected from whichever key you set: anthropic | openai | gemini
AI_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Model name. Anthropic defaults to claude-sonnet-5-5. For openai and gemini you MUST set this:
# copy an exact model ID from the provider's current model list.
AI_MODEL=
# Optional: any OpenAI-compatible service (OpenRouter, Groq, local Ollama...), e.g. https://openrouter.ai/api/v1
AI_BASE_URL=
# Cost controls for the AI layer: max characters of code sent per scan, and max API calls per scan
AI_MAX_CHARS=150000
AI_MAX_BATCHES=4
# Give up on a slow AI call after this many seconds (the scan still finishes without it)
AI_TIMEOUT_SECONDS=30

# Privacy: delete the uploaded code from storage as soon as a scan finishes (the report keeps the findings)
DELETE_UPLOADS_AFTER_SCAN=true
# Test and fixture folders are skipped by default (they mostly hold fake secrets). Set true to scan them too
SCAN_INCLUDE_TESTS=false

# Sign in with Google (optional). The Client ID from Google Cloud Console. It is public, not a secret.
GOOGLE_CLIENT_ID=

# Link Checker (optional): a free Google Safe Browsing API key lets it also check links against Google's lists
# of dangerous sites. Without it, the checker still works using pattern checks only.
SAFE_BROWSING_API_KEY=

# Check package.json dependencies against the free OSV.dev database (set false to disable)
OSV_ENABLED=true

# Cloudflare R2 (leave empty to use local disk in server/uploads)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Addresses allowed to open the /admin page, comma-separated. Must be confirmed (Google sign-in counts).
ADMIN_EMAILS=

# Email (Brevo). Optional. Without these, password reset, email verification and scan alerts switch themselves off.
# 1) Make a free account at brevo.com  2) Senders, Domains & Dedicated IPs -> Senders -> add and verify your address
# 3) SMTP & API -> API keys -> create one
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Threat Modeler
# The address of the web app, used to build the links in emails. Defaults to the first CLIENT_ORIGIN.
APP_URL=

# Paid plans (Paystack). Leave BILLING_ENABLED off while testing: everyone then gets the Team limits.
# 1) paystack.com -> Settings -> API Keys: copy the SECRET key (start with the TEST key)
# 2) Commerce -> Plans: make 4 USD plans, then paste each plan code (PLN_...)
# 3) Settings -> API Keys & Webhooks: set the webhook URL to https://YOUR-SERVER/api/webhooks/paystack
BILLING_ENABLED=false
PAYSTACK_SECRET_KEY=
PAYSTACK_PLAN_PRO_MONTHLY=
PAYSTACK_PLAN_PRO_ANNUAL=
PAYSTACK_PLAN_TEAM_MONTHLY=
PAYSTACK_PLAN_TEAM_ANNUAL=

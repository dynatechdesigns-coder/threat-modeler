# Optional. By default the Vite dev server proxies /api to http://localhost:5000.
# Set this when the API is hosted elsewhere (e.g. production). It must end with /api
# VITE_API_URL=https://your-api.onrender.com/api

# Sign in with Google (optional). The same Client ID you put in the server's GOOGLE_CLIENT_ID. It is public.
# VITE_GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com

# Firebase web app config (required). Copy each value from the Firebase console:
# Project settings > General > Your apps > Web app. These are public identifiers.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=

# Firebase App Check with Fraud Defense (reCAPTCHA Enterprise).
# Create/register the key in the Firebase console:
# App Check > your web app > reCAPTCHA Enterprise, using an Enterprise key
# from the Google Cloud console (Fraud Defense). Must belong to the SAME
# project above.
# VITE_RECAPTCHA_SITE_KEY=

# Local dev only: paste a debug token here AND register it under
# Firebase console > App Check > Manage debug tokens. Never set in production.
# VITE_APPCHECK_DEBUG_TOKEN=

# Optional. By default the Vite dev server proxies /api to http://localhost:5000.
# Set this when the API is hosted elsewhere (e.g. production). It must end with /api
# VITE_API_URL=https://your-api.onrender.com/api

# Sign in with Google (optional). The same Client ID you put in the server's GOOGLE_CLIENT_ID. It is public.
# VITE_GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
